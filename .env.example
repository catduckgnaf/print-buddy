# Print Buddy Docker settings. Copy to .env next to docker-compose.yml, fill in, and keep it private
# (chmod 600 .env): it holds secrets. Every setting is documented in docs/SETTINGS.md.
# Example hosts use the reserved .example domain; replace them with your own.

# --- Container -------------------------------------------------------------------------------
# Pin an exact release for controlled upgrades and rollback (docs/DOCKER.md); "stable" moves.
PRINT_BUDDY_TAG=stable
# PRINT_BUDDY_IMAGE=ghcr.io/catduckgnaf/print-buddy
# Host folder for all persistent data. Must be owned by PUID:PGID.
PRINT_BUDDY_DATA=./data
PUID=1000
PGID=1000
TZ=Etc/UTC
# PRINT_BUDDY_CPUS=2
# PRINT_BUDDY_MEMORY=4g
# PRINT_BUDDY_HEALTH_MAX_AGE_S=90

# Settings file. YAML is the default; a legacy TOML mount stays supported:
# PRINT_BUDDY_CONFIG=/app/config/local.yaml
# PRINT_BUDDY_CONFIG=/app/config/docker.toml

# --- Spoolman ----------------------------------------------------------------------------------
# External Spoolman (default): point at your server.
PRINT_BUDDY__SERVICES__SPOOLMAN_URL=http://spoolman.example:7912
# Bundled Spoolman instead: uncomment. Its URL is then set for you and the line above is ignored.
# COMPOSE_FILE=docker-compose.yml:docker-compose.spoolman.yml
# SPOOLMAN_TAG=0.27.0
# SPOOLMAN_PORT=7912

# --- Printer -----------------------------------------------------------------------------------
# flashforge.ad5x, sovol.sv06, klipper.generic (Moonraker) or octoprint.marlin (OctoPrint)
PRINT_BUDDY__PRINTER__MODEL=flashforge.ad5x
# Klipper / Moonraker printers (Fluidd or Mainsail run on the printer; not bundled):
PRINT_BUDDY__SERVICES__MOONRAKER_URL=http://printer.example:7125
# OctoPrint printers:
# PRINT_BUDDY__SERVICES__OCTOPRINT_URL=http://octoprint.example

# --- Secrets (environment only, never YAML) ------------------------------------------------------
# DISCORD_BOT_TOKEN=
# OCTOPRINT_API_KEY=
# MOONRAKER_API_KEY=
# CLIPROXY_API_KEY=
# OPENVIKING_API_KEY=

# --- Every other setting, with its Docker default --------------------------------------------------
# Lists and tables (orca.command, printer.bed_mm, material_temps, cold_pull) are file-only.
# printer, layout and prime_tower values shown are the flashforge.ad5x model defaults; other
# models bring their own (docs/SETTINGS.md).

# [printer]
# PRINT_BUDDY__PRINTER__NAME=Flashforge AD5X
# PRINT_BUDDY__PRINTER__FIRMWARE=ZMod Klipper
# PRINT_BUDDY__PRINTER__START_MACRO=START_PRINT
# PRINT_BUDDY__PRINTER__END_MACRO=END_PRINT
# PRINT_BUDDY__PRINTER__MAX_PRINT_HEIGHT_MM=220.0
# PRINT_BUDDY__PRINTER__NOZZLE_DIAMETER_MM=0.4
# PRINT_BUDDY__PRINTER__IFS_SLOTS=4
# PRINT_BUDDY__PRINTER__NOZZLE_TYPE=

# [layout]
