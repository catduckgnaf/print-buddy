#!/usr/bin/env python3
"""CLI entrypoint for guarded idle slot loading."""
import argparse
import json
import sys

from print_buddy.hermes.slot_load import load_slot


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Guarded idle-only IFS slot loader for AD5X (wraps ZMod macros; offline/idle only)",
    )
    parser.add_argument("slot", help="IFS physical slot number (1-4)")
    parser.add_argument(
        "--json",
        action="store_true",
        help="Always output JSON",
    )
    args = parser.parse_args()

    result = load_slot(args.slot)

    if args.json or not sys.stdout.isatty():
        print(json.dumps(result, indent=2))
    else:
        if result.get("ok"):
            print(result.get("message", "OK"))
        else:
            print(f"FAILED: {result.get('error', 'Unknown error')}", file=sys.stderr)

    sys.exit(0 if result.get("ok") else 1)


if __name__ == "__main__":
    main()
