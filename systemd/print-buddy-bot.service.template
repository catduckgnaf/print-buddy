[Unit]
Description=Print Buddy standalone Discord bot (no Hermes, no LLM needed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PRINT_BUDDY__BOT__MODE=standalone
# DISCORD_BOT_TOKEN (and LLM_API_KEY, if [llm] is set) live here, never in the config files.
EnvironmentFile=-{{DATA_HOME}}/.env
WorkingDirectory={{REPO}}
ExecStart={{PYTHON}} -m print_buddy.bot run
Restart=always
RestartSec=10
MemoryMax=2G

[Install]
WantedBy=default.target
